# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.venv/
venv/
Data/

# Copies kept before a patch of the program: the vanilla executable and the save files of the player
mod_project/backups/exe/
mod_project/backups/saves/
