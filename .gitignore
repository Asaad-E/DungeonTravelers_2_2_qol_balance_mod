# Ignore game install binaries and media
DungeonTravelers2-2_EN/
*.exe
*.dll
*.pck
*.movie
*.tex
*.png
*.jpg
*.jpeg

# Except backups inside mod_project
!mod_project/backups/*.pck
!mod_project/backups/Script/*.pck
!mod_project/backups/Enemy/*.pck
!mod_project/backups/Dungeon/*.pck
!mod_project/backups/Summon/*.pck
