# Ignore game install binaries and media
DungeonTravelers2-2_EN/
*.exe
*.dll
*.pck
*.movie
*.tex
*.png
*.jpg
*.jpeg

!data_tables/*.xlsx

# The originals of the game: each user copies them from a copy of the game (tools/setup_backups.py)
backups/

# Where the game is on this machine, and the archives made for players (they hold files of the game)
config.json

dist/

# What a measure writes beside itself while it runs
measures/*.json
measures/*.log
measures/*.xlsx

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.venv/
venv/
Data/

# Copies kept before a patch of the program: the vanilla executable and the save files of the player
backups/exe/
backups/saves/

# What the builds write: generated from the workbooks and the backups
build/

# Local settings of the assistant
.claude/

# Snapshots of a workbook kept beside a working script
scratch/**/*.xlsx
scratch/*.xlsx

# Working notes kept on this machine only
CLAUDE.md
docs/BALANCE_PLAN.md

# raw figures of the on-demand mass tests (dtcli skill-battery, unique-battery, support-battery); the reports .md are kept
docs/generated/skill_battery/
docs/generated/skill_battery_variants/
docs/generated/skill_battery_trial/
# the reports of a trial run (dtcli skill-battery ... trial): not the state of the mod
docs/generated/SKILL_BATTERY_TRIAL.md
docs/generated/SKILL_BATTERY_VARIANTS_TRIAL.md
docs/generated/skill_battery_variants_trial/
docs/generated/support_battery/
docs/generated/unique_battery/
docs/generated/mercenary_battery/
# the charts of the suite (tools/suite_charts.py) are kept: they show the state of the mod
!docs/generated/charts/*.png
